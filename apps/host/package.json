{
  "name": "@app/host",
  "version": "1.0.0",
  "private": true,
  "description": "AI 办公桌面客户端宿主（微内核）",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "antd": "^5.17.0",
    "docx": "^8.5.0",
    "highlight.js": "^11.9.0",
    "mammoth": "^1.7.2",
    "marked": "^12.0.2",
    "officeparser": "^4.1.1",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.6",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aioffice.assistant",
    "productName": "AI Office Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      {
        "from": "../../plugins/office-parser",
        "to": "plugins/office-parser",
        "filter": ["dist/**/*", "package.json"]
      },
      {
        "from": "../../plugins/custom-tool-agent",
        "to": "plugins/custom-tool-agent",
        "filter": ["dist/**/*", "package.json"]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
